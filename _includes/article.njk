---
layout: base.njk
---
<article class="wrap-narrow" style="padding:var(--space-8) 0">
  <a href="/articles/" class="text-muted" style="font-size:14px">&larr; Back to all articles</a>
  {% if topic %}<div style="margin-top:var(--space-3)"><span class="tag">{{ topic }}</span></div>{% endif %}
  <h1 style="margin-top:var(--space-2)">{{ title }}</h1>
  <p class="text-muted" style="margin-bottom:var(--space-6)">{{ date }}</p>
  <div class="article-body" style="font-size:17px;text-align:justify">{{ content | safe }}</div>
  {% if pdf %}<p><a class="btn pdf-link" href="{{ pdf }}" target="_blank">Download PDF</a></p>{% endif %}
</article>
